---
import Base from '../../../layouts/Base.astro';
import BlogLayout from '../../../components/BlogLayout.astro';
import { getCollection, render } from 'astro:content';

// Builds every EN post, drafts included — mirrors src/pages/blog/[slug].astro.
export async function getStaticPaths() {
  const posts = await getCollection('blogEn');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base lang="en" title={`${post.data.title} — pin`} description={post.data.excerpt}>
  <BlogLayout
    lang="en"
    slug={post.id}
    title={post.data.title}
    author={post.data.author}
    publishDate={post.data.publishDate}
    readingMinutes={post.data.readingMinutes}
    tags={post.data.tags}
  >
    <Content />
  </BlogLayout>
</Base>
