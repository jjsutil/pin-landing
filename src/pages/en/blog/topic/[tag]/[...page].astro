---
// Per-topic EN listing (I-012): /en/blog/topic/<slug> and /en/blog/topic/<slug>/2.
// The tag filter used to be a client-side button over every card in the DOM;
// with paginated routes that would have searched one page's six posts instead
// of the blog, so a topic is a real, shareable, paginated URL instead.
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import BlogList from '../../../../../components/BlogList.astro';
import { tagIndex } from '../../../../../content/blog/tags';
import { PAGE_SIZE } from '../../../../../content/blog/listing';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blogEn', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );
  const tags = tagIndex(posts.map((post) => post.data.tags));
  return tags.flatMap(({ label, slug }) => {
    const tagged = posts.filter((post) => post.data.tags.includes(label));
    return paginate(tagged, {
      params: { tag: slug },
      pageSize: PAGE_SIZE,
      // Timeline scope is the topic — "this subject, over time". The chip row
      // is NOT scoped: it lists every topic in the blog, because it is the way
      // out of the one you are standing in.
      props: { timelinePosts: tagged, tags, activeTag: label },
    });
  });
}) satisfies GetStaticPaths;

const { page, timelinePosts, tags, activeTag } = Astro.props;
const suffix = page.currentPage > 1 ? ` (page ${page.currentPage})` : '';
---

<Base
  lang="en"
  title={`${activeTag}${suffix} — Blog pin`}
  description={`Posts from pin about ${activeTag}.`}
>
  <section>
    <BlogList lang="en" page={page} timelinePosts={timelinePosts} tags={tags} activeTag={activeTag} />
  </section>
</Base>
