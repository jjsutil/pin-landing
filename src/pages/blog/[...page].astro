---
// Paginated ES blog listing (I-012): /blog and /blog/2, built by Astro's own
// paginate(). Replaces the client-side "Ver más" reveal — each page now ships
// only its own cards.
//
// Shares the /blog/* space with [slug].astro (the posts). They cannot collide:
// each emits only the paths its own getStaticPaths returns, and no post slug is
// a bare number. The adjacency is not obvious, hence this note.
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogList from '../../components/BlogList.astro';
import { tagIndex } from '../../content/blog/tags';
import { PAGE_SIZE } from '../../content/blog/listing';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );
  // The timeline is unpaginated by design (I-012 anti-scope, I-013), so every
  // page carries the whole list for it alongside its own slice. `tagIndex`
  // throws at build time if two topics would share one URL slug.
  return paginate(posts, {
    pageSize: PAGE_SIZE,
    props: { timelinePosts: posts, tags: tagIndex(posts.map((post) => post.data.tags)) },
  });
}) satisfies GetStaticPaths;

const { page, timelinePosts, tags } = Astro.props;
const title = page.currentPage > 1 ? `Blog (página ${page.currentPage}) — pin` : 'Blog — pin';
---

<Base lang="es" title={title} description="Ideas y guías de pin sobre lectura de expedientes.">
  <section>
    <BlogList lang="es" page={page} timelinePosts={timelinePosts} tags={tags} />
  </section>
</Base>
