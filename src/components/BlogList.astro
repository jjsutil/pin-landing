---
// Shared blog-listing markup for /blog (ES) and /en/blog (EN) — condensed
// card grid, tag filter, "ver más"/"show more" reveal past PAGE_SIZE (I-011).
// No visit counter by design: static site, no backend — order is by
// publishDate only (owner decision, issue I-011).
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const blogBase = lang === 'en' ? `${base}/en/blog` : `${base}/blog`;

const posts = (
  await getCollection(lang === 'en' ? 'blogEn' : 'blog', ({ data }) => !data.draft)
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Unique tags, first-seen order — posts are already date-sorted above.
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

const dateFmt = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-CL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// Short form for the timeline's date gutter — the full "6 de agosto de 2026"
// doesn't fit a slim column (I-013).
const dateFmtShort = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-CL', {
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const PAGE_SIZE = 10;

const STR =
  lang === 'en'
    ? {
        eyebrow: 'Blog',
        h1: 'Ideas and guides from pin',
        empty: 'We will publish here soon.',
        filterLabel: 'Filter by topic',
        all: 'All',
        emptyTag: 'No post uses that topic yet.',
        minRead: 'min read',
        more: 'Show more',
        viewLabel: 'View as',
        viewGrid: 'Grid',
        viewTimeline: 'Timeline',
      }
    : {
        eyebrow: 'Blog',
        h1: 'Ideas y guías de pin',
        empty: 'Pronto vamos a publicar acá.',
        filterLabel: 'Filtrar por tema',
        all: 'Todos',
        emptyTag: 'Ningún post usa ese tema todavía.',
        minRead: 'min de lectura',
        more: 'Ver más',
        viewLabel: 'Ver como',
        viewGrid: 'Grilla',
        viewTimeline: 'Línea de tiempo',
      };
---

<div class="wrap stack-l">
  <div class="stack-s">
    <p class="eyebrow">{STR.eyebrow}</p>
    <h1>{STR.h1}</h1>
  </div>

  {
    posts.length === 0 ? (
      <p class="blog-empty">{STR.empty}</p>
    ) : (
      <Fragment>
        {/* One control row: tag filters on the left, the view switch on the
            right. The switch is icon-only and reuses the site's existing
            `.segmented` control (as in the pricing toggle) so it never reads
            as one more tag chip — owner: two rows of pills was confusing. */}
        <div class="blog-toolbar">
          {tags.length > 0 ? (
            <div class="blog-filters" id="blog-filters" role="group" aria-label={STR.filterLabel}>
              <button type="button" class="blog-filter" data-tag="" aria-pressed="true">
                {STR.all}
              </button>
              {tags.map((tag) => (
                <button type="button" class="blog-filter" data-tag={tag} aria-pressed="false">
                  {tag}
                </button>
              ))}
            </div>
          ) : (
            <span />
          )}

          <div class="segmented blog-view-toggle" role="group" aria-label={STR.viewLabel}>
            <button
              type="button"
              class="seg blog-view-btn"
              data-view="grid"
              aria-pressed="true"
              aria-label={STR.viewGrid}
              title={STR.viewGrid}
            >
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <rect x="2" y="2" width="5" height="5" rx="1" />
                <rect x="9" y="2" width="5" height="5" rx="1" />
                <rect x="2" y="9" width="5" height="5" rx="1" />
                <rect x="9" y="9" width="5" height="5" rx="1" />
              </svg>
            </button>
            <button
              type="button"
              class="seg blog-view-btn"
              data-view="timeline"
              aria-pressed="false"
              aria-label={STR.viewTimeline}
              title={STR.viewTimeline}
            >
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                <path d="M3.25 2v12" />
                <path d="M6 4.25h7" />
                <path d="M6 8h5" />
                <path d="M6 11.75h7" />
              </svg>
            </button>
          </div>
        </div>

        <div id="blog-view-grid">
          <ul class="blog-cards" id="blog-cards">
            {posts.map((post, i) => (
              <li class="blog-card" data-tags={post.data.tags.join('|')} data-index={i} hidden={i >= PAGE_SIZE}>
                <a href={`${blogBase}/${post.id}`}>
                  <h2>{post.data.title}</h2>
                  <p class="lede">{post.data.excerpt}</p>
                  <p class="aside blog-meta">
                    <span>{post.data.author}</span>
                    <span aria-hidden="true">·</span>
                    <time datetime={post.data.publishDate.toISOString()}>
                      {dateFmt.format(post.data.publishDate)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>
                      {post.data.readingMinutes} {STR.minRead}
                    </span>
                  </p>
                </a>
                {post.data.tags.length > 0 && (
                  <ul class="blog-tags">
                    {post.data.tags.map((tag) => (
                      <li class="badge">{tag}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>

          <p class="blog-empty" id="blog-empty" hidden>
            {STR.emptyTag}
          </p>

          {posts.length > PAGE_SIZE && (
            <button type="button" class="btn btn-ghost" id="blog-more" data-page-size={PAGE_SIZE}>
              {STR.more}
            </button>
          )}
        </div>

        <div id="blog-view-timeline" hidden>
          <div class="blog-timeline-viewport" id="blog-timeline-viewport">
            <ul class="blog-timeline-list" id="blog-timeline-list">
              {posts.map((post) => (
                <li class="blog-timeline-row">
                  <a href={`${blogBase}/${post.id}`} class="blog-timeline-link">
                    <p class="blog-timeline-date">
                      {dateFmtShort.format(post.data.publishDate)}
                    </p>
                    <span class="blog-timeline-content">
                      <h2>{post.data.title}</h2>
                      <p>{post.data.excerpt}</p>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="blog-timeline-fill" id="blog-timeline-fill"></div>
          </div>
        </div>
      </Fragment>
    )
  }
</div>

<script>
  // Tag filter + "show more" pagination, client-side only — no build-time
  // route explosion, no new dependency (I-011). A tag filter shows every
  // match (already a short list); pagination only gates the unfiltered view.
  const filters = document.querySelectorAll<HTMLButtonElement>('.blog-filter');
  const cards = document.querySelectorAll<HTMLLIElement>('#blog-cards .blog-card');
  const empty = document.getElementById('blog-empty');
  const moreBtn = document.getElementById('blog-more') as HTMLButtonElement | null;
  const pageSize = moreBtn ? Number(moreBtn.dataset.pageSize) : cards.length;
  let shown = pageSize;
  let activeTag = '';

  function render() {
    let visible = 0;
    cards.forEach((card) => {
      const cardTags = (card.dataset.tags ?? '').split('|');
      const matchesTag = activeTag === '' || cardTags.includes(activeTag);
      const withinPage = activeTag !== '' || Number(card.dataset.index) < shown;
      const show = matchesTag && withinPage;
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (empty) empty.hidden = visible > 0;
    if (moreBtn) moreBtn.hidden = activeTag !== '' || shown >= cards.length;
  }

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      activeTag = button.dataset.tag ?? '';
      filters.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      render();
    });
  });

  moreBtn?.addEventListener('click', () => {
    shown += pageSize;
    render();
  });

  render();

  // View toggle — grid (tag filter + show-more, above) vs. timeline (I-013).
  // Two independent containers, one shown at a time; nothing about the grid's
  // own tag-filter/pagination state above needs to know this exists.
  const viewButtons = document.querySelectorAll<HTMLButtonElement>('.blog-view-btn');
  const viewGrid = document.getElementById('blog-view-grid');
  const viewTimeline = document.getElementById('blog-view-timeline');
  // The tag filter belongs to the grid only (the timeline is chronological by
  // design, I-013), but it now lives in the shared toolbar — so it hides with it.
  const filterBar = document.getElementById('blog-filters');

  viewButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const isTimeline = button.dataset.view === 'timeline';
      viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      if (viewGrid) viewGrid.hidden = isTimeline;
      if (filterBar) filterBar.hidden = isTimeline;
      if (viewTimeline) viewTimeline.hidden = !isTimeline;
      if (isTimeline) updateTimelineFocus();
    });
  });

  // Timeline scroll-focus (I-013, reshaped in I-016) — only zoom and blur are
  // animated, and the falloff is measured in row-heights, not viewport-halves:
  // one row away from the centre the effect is already gone, so exactly one post
  // reads as highlighted instead of the whole column. The accent mark on the
  // divider is a short segment that slides to the active row (it used to be a
  // fill growing from the top — long, and it never pointed at anything). Rows
  // carry no CSS transition: these values are written every animation frame, and
  // a transition on top of that lags behind the scroll instead of smoothing it.
  // All of it is skipped in static mode — see the guard below (I-004).
  const timelineViewport = document.getElementById('blog-timeline-viewport');
  const timelineList = document.getElementById('blog-timeline-list');
  const timelineFill = document.getElementById('blog-timeline-fill');
  let timelineUpdateQueued = false;
  let timelineFocusCleared = false;

  // Single source of truth for static mode: the `perf-lite` class main.ts puts on
  // <html>, which covers both prefers-reduced-motion and the FPS self-benchmark
  // (I-004). Read on every pass, not once at load: the benchmark resolves ~300ms in,
  // so a value captured here at parse time would always say "not static".
  const isStatic = () => document.documentElement.classList.contains('perf-lite');

  // Static mode can start mid-session (see above), and by then rows carry inline
  // transform/filter from earlier passes — bailing without clearing them would
  // freeze half the list blurred forever. The mark is moved with `transform`
  // since I-016 (it used to grow via `height`), so that is what has to be reset;
  // `html.perf-lite` also hides it in CSS, and clearing the inline value keeps
  // the two from disagreeing if the class is ever removed again.
  function clearTimelineFocus() {
    if (!timelineList || !timelineFill) return;
    for (const row of timelineList.querySelectorAll<HTMLLIElement>('.blog-timeline-row')) {
      row.style.transform = '';
      row.style.filter = '';
      row.classList.remove('is-active');
    }
    timelineFill.style.transform = '';
  }

  function updateTimelineFocus() {
    timelineUpdateQueued = false;
    if (!timelineViewport || !timelineList || !timelineFill) return;
    if (isStatic()) {
      if (!timelineFocusCleared) {
        clearTimelineFocus();
        timelineFocusCleared = true;
      }
      return;
    }
    // Re-arm the one-shot clear: static mode can be entered more than once in a
    // session, and a latched flag would skip the cleanup on the second entry.
    timelineFocusCleared = false;
    // Plain for-of, not .forEach: TS can't narrow a `let` reassigned inside a
    // callback's separate scope, so `active` stayed `never` post-loop there.
    const rows = Array.from(timelineList.querySelectorAll<HTMLLIElement>('.blog-timeline-row'));
    const vRect = timelineViewport.getBoundingClientRect();
    const centerY = vRect.top + vRect.height / 2;
    let active: HTMLLIElement | null = null;
    let bestDist = Infinity;

    for (const row of rows) {
      const r = row.getBoundingClientRect();
      const dist = Math.abs(r.top + r.height / 2 - centerY);
      // Linear ramp over one row-height, then smoothstep so the highlight
      // eases in and out instead of arriving with a visible kink.
      const t = Math.max(0, 1 - dist / r.height);
      const focus = t * t * (3 - 2 * t);
      // Half the amplitude the first build shipped (0.978→1.025), owner's call
      // 2026-08-07: same deviation either side of 1, just half of it. The blur
      // is what carries the focus; the zoom only has to hint at it.
      row.style.transform = `scale(${(0.989 + focus * 0.023).toFixed(3)})`;
      row.style.filter = `blur(${((1 - focus) * 0.9).toFixed(2)}px)`;
      if (dist < bestDist) {
        bestDist = dist;
        active = row;
      }
    }

    for (const row of rows) row.classList.toggle('is-active', row === active);

    if (active) {
      // Content-space coordinates: the mark is absolutely positioned inside the
      // scrolling viewport, so it scrolls with the list; `top: 2rem` in CSS is
      // the viewport's own padding, i.e. the list's origin.
      const listTop = timelineList.getBoundingClientRect().top;
      const r = active.getBoundingClientRect();
      const markH = timelineFill.offsetHeight;
      const y = r.top + r.height / 2 - listTop - markH / 2;
      timelineFill.style.transform = `translateY(${Math.max(0, y).toFixed(1)}px)`;
    }
  }

  function queueTimelineUpdate() {
    if (timelineUpdateQueued) return;
    timelineUpdateQueued = true;
    requestAnimationFrame(updateTimelineFocus);
  }

  timelineViewport?.addEventListener('scroll', queueTimelineUpdate, { passive: true });
  // Guarded, not unconditional: while the timeline is hidden, its viewport
  // has zero height, so the focus math divides by zero (NaN) on every
  // window resize — harmless (invalid CSS values are dropped) but wasted.
  window.addEventListener('resize', () => {
    if (!viewTimeline?.hidden) queueTimelineUpdate();
  });

  // The FPS benchmark (I-004) adds `perf-lite` ~300ms after load, which is a state
  // change with no event of its own: without this, the cleanup below waits for the
  // next scroll, and a visitor who simply stops scrolling is left looking at rows
  // frozen mid-effect — half the list blurred, a stale row still marked active.
  // Watching the class is what makes the transition self-healing in both directions.
  // `perf-lite` is the only writer of this attribute today — the theme toggle uses
  // `data-theme` (main.ts), so it never fires this — but the callback still goes
  // through the same guards as the resize handler: rAF-coalesced, and skipped while
  // the timeline is hidden, so a future class write costs nothing.
  new MutationObserver(() => {
    if (!viewTimeline?.hidden) queueTimelineUpdate();
  }).observe(document.documentElement, { attributeFilter: ['class'] });
</script>
