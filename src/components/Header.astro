---
import { T, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = T[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="bar">
  <div class="wrap bar-inner">
    <a class="mark" href={`${base}/`} aria-label="pin">pin<span class="dot">.</span></a>
    <div class="bar-actions">
      <div class="lang" role="group" aria-label="Idioma / Language">
        <button type="button" id="lang-es" aria-pressed={lang === 'es' ? 'true' : 'false'}>ES</button>
        <button type="button" id="lang-en" aria-pressed={lang === 'en' ? 'true' : 'false'}>EN</button>
      </div>
      <a class="nav-link" href={`${base}${lang === 'en' ? '/en/blog' : '/blog'}`}>{d['nav.blog']}</a>
      <button class="icon-btn" type="button" id="theme" aria-label={d['theme.dark']}>
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path id="theme-icon" d="M13.2 9.6A5.6 5.6 0 0 1 6.4 2.8 5.6 5.6 0 1 0 13.2 9.6Z" stroke-linejoin="round"></path>
        </svg>
      </button>
      <a class="btn btn-sm" href="#acceso" id="go-access">{d['nav.login']}</a>
    </div>
  </div>
</header>
