---
import { ES_TO_EN, EN_TO_ES } from '../content/blog/translations';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  author: string;
  publishDate: Date;
  readingMinutes: number;
  tags: string[];
}

const { lang, slug, title, author, publishDate, readingMinutes, tags } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const dateLabel = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-CL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(publishDate);

// Share CTA (I-006): repost on X/LinkedIn + copy-link. Owner decision
// 2026-08-05 — sharing only, no comment box, no third-party tracking script.
const shareUrl = Astro.url.href;
const xShareHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(shareUrl)}`;
const linkedinShareHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;

// Cross-language link (I-011): only rendered when this post has a translated
// counterpart (translations.ts), so a post that hasn't been translated yet
// never shows a dead link.
const altSlug = lang === 'en' ? EN_TO_ES[slug] : ES_TO_EN[slug];
const altHref = altSlug ? `${base}${lang === 'en' ? '/blog' : '/en/blog'}/${altSlug}` : undefined;

const STR =
  lang === 'en'
    ? {
        eyebrow: 'Blog',
        minRead: 'min read',
        share: 'Share:',
        shareX: 'Share this post on X (Twitter)',
        shareLi: 'Share this post on LinkedIn',
        copy: 'Copy post link',
        copied: 'Link copied',
        shareAria: 'Share this post',
        altLabel: 'Leer en español',
      }
    : {
        eyebrow: 'Blog',
        minRead: 'min de lectura',
        share: 'Compartir:',
        shareX: 'Compartir este post en X (Twitter)',
        shareLi: 'Compartir este post en LinkedIn',
        copy: 'Copiar enlace del post',
        copied: 'Enlace copiado',
        shareAria: 'Compartir este post',
        altLabel: 'Read in English',
      };
---

<section>
  <article class="wrap blog-post stack-l">
    <header class="stack-s">
      <p class="eyebrow">{STR.eyebrow}</p>
      <h1>{title}</h1>
      <p class="aside blog-meta">
        <span>{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={publishDate.toISOString()}>{dateLabel}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} {STR.minRead}</span>
        {altHref && (
          <Fragment>
            <span aria-hidden="true">·</span>
            <a href={altHref}>{STR.altLabel}</a>
          </Fragment>
        )}
      </p>
      {tags.length > 0 && (
        <ul class="blog-tags">
          {tags.map((tag) => (
            <li class="badge">{tag}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="blog-body">
      <slot />
    </div>

    <footer class="blog-share" aria-label={STR.shareAria}>
      <span class="blog-share-label">{STR.share}</span>
      <a
        class="btn btn-ghost blog-share-btn"
        href={xShareHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={STR.shareX}
      >
        X / Twitter
      </a>
      <a
        class="btn btn-ghost blog-share-btn"
        href={linkedinShareHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={STR.shareLi}
      >
        LinkedIn
      </a>
      <button
        type="button"
        class="btn btn-ghost blog-share-btn"
        id="blog-copy-link"
        data-url={shareUrl}
        data-copied-label={STR.copied}
        role="status"
        aria-live="polite"
      >
        {STR.copy}
      </button>
    </footer>
  </article>
</section>

<script>
  // Copy-link fallback for the share CTA (I-006) — no external service, no
  // tracking script.
  const copyBtn = document.getElementById('blog-copy-link');
  copyBtn?.addEventListener('click', async () => {
    const url = copyBtn.dataset.url ?? '';
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      return;
    }
    const original = copyBtn.textContent;
    copyBtn.textContent = copyBtn.dataset.copiedLabel ?? original;
    copyBtn.dataset.copied = 'true';
    setTimeout(() => {
      copyBtn.textContent = original;
      delete copyBtn.dataset.copied;
    }, 2000);
  });
</script>
