---
import '../styles/global.css';
import { T, type Lang } from '../i18n';
import Header from '../components/Header.astro';
import AccessView from '../components/AccessView.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const d = T[lang];
const pageTitle = title ?? d['title'];
const pageDescription = description ?? d['meta.desc'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CL' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <!-- issue #3.1 — sin JS el contenido se ve igual, solo sin animar -->
    <noscript>
      <style>
        .rise, .rise-x { opacity: 1; transform: none; }
        .said::before, .said:last-of-type::after { transform: scaleX(1); }
        .ask { display: none; }
      </style>
    </noscript>
    <script is:inline>
      // Tema: sistema por defecto; la elección del toggle persiste en localStorage.
      // Inline y antes del primer paint para evitar el destello del tema equivocado.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) { /* sin storage: queda el tema del sistema */ }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#top">{d['skip']}</a>
    <Header lang={lang} />
    <main id="top">
      <slot />
    </main>
    <AccessView lang={lang} />
    <Footer lang={lang} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
