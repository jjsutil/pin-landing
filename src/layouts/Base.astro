---
import '../styles/global.css';
import { T, type Lang } from '../i18n';
import Header from '../components/Header.astro';
import AccessView from '../components/AccessView.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = T[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d['title']}</title>
    <script is:inline>
      // Tema: sistema por defecto; la elección del toggle persiste en localStorage.
      // Inline y antes del primer paint para evitar el destello del tema equivocado.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) { /* sin storage: queda el tema del sistema */ }
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} />
    <main id="top">
      <slot />
    </main>
    <AccessView lang={lang} />
    <Footer lang={lang} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
